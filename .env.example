# Copiá este archivo a .env y completalo. NO commitear .env (ya está en .gitignore).
# Estos valores son para el stack LOCAL: en producción los secretos se generan fuertes y se cargan
# desde AWS SSM (ver docs/02-produccion-aws-terraform.md §13).

# Perfiles de Docker Compose. "dev" levanta Jupyter (entorno de desarrollo).
COMPOSE_PROFILES=dev

POSTGRES_USER=airflow
POSTGRES_PASSWORD=airflow            # prod: openssl rand -hex 24
POSTGRES_DB=airflow

AIRFLOW_JWT_SECRET=change-me-in-prod # prod: openssl rand -hex 32
AIRFLOW_ADMIN_USER=admin
AIRFLOW_ADMIN_PASSWORD=admin         # prod: valor fuerte

JUPYTER_TOKEN=                       # vacío = JupyterLab sin autenticación; poné un token largo
